{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solana-vault.invalid/schemas/incident-rehearsal-v1.json",
  "title": "Solana Vault incident rehearsal record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "status",
    "scenario",
    "startedAt",
    "completedAt",
    "participants",
    "evidenceReferences",
    "findings",
    "followUps"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "production" },
    "status": { "enum": ["planned", "completed"] },
    "scenario": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "participants": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "followUps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ownerId", "dueAt", "status"],
        "properties": {
          "ownerId": { "type": "string", "minLength": 1 },
          "dueAt": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "closed"] }
        }
      }
    }
  }
}
