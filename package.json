{
  "private": true,
  "license": "ISC",
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test:sdk": "ts-mocha -p tsconfig.json \"sdk/tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sdk:build": "corepack yarn workspace solana-vault-prototype-sdk run build",
    "inventory:legacy": "ts-node scripts/inventory_legacy_accounts.ts",
    "manifests:validate": "ts-node scripts/validate_production_manifests.ts",
    "manifests:validate:examples": "ts-node scripts/validate_production_manifests.ts ops/examples --allow-placeholders",
    "release:evidence": "ts-node scripts/generate_release_evidence.ts",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:test": "npm --prefix app run test",
    "app:typecheck": "npm --prefix app run typecheck"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@solana/web3.js": "^1.98.4"
  },
  "resolutions": {
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
