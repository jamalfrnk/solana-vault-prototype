# Build artifacts
target/
.anchor/
test-ledger/
node_modules/
coverage/

# Next.js app (M14)
app/.next/
app/out/
app/next-env.d.ts
*.tsbuildinfo

# SDK package build output (M19)
sdk/dist/

# Anchor / Solana tooling artifacts
**/*.rs.bk
.yarn
.surfpool

# Environment files (keep the example)
.env
.env.*
!.env.example

# Wallets and keypairs — narrow patterns only; never use a broad *.json rule,
# which would hide legitimate Anchor/Node/project configuration.
*-keypair.json
wallet.json
id.json
keys/
keypairs/

# Logs
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
